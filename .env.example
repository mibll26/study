# Supabase Postgres (Project Settings → Database → Connection string)
# DATABASE_URL: Transaction pooler (포트 6543) — 앱 런타임
# DIRECT_URL  : Direct connection / Session pooler (포트 5432) — prisma migrate
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# 식품안전나라 Open API (C003) — 관리자 → 데이터 동기화 화면에서 입력해도 됨 (화면 입력이 우선)
# 발급: https://www.foodsafetykorea.go.kr/api/
MFDS_API_KEY=

# Anthropic API (AI 배합 추천) — 관리자 → 데이터 동기화 화면에서 입력해도 됨 (화면 입력이 우선)
# 발급: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
